APP_ENV=development
LOG_LEVEL=INFO
PAPER_TRADING=true
MAX_DAILY_LOSS_PCT=2.0
MAX_PORTFOLIO_EXPOSURE_PCT=60.0
MAX_POSITION_PCT=10.0
EXECUTION_CHECKPOINT_PATH=runtime/execution.json
EXECUTION_TIMEOUT_SECONDS=5.0
TIMEOUT_SWEEP_INTERVAL_SECONDS=1.0

# Never commit real credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
TINVEST_TOKEN=
